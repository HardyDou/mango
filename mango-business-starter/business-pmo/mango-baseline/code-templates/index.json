{
  "schemaVersion": 1,
  "templates": [
    {
      "id": "business-module",
      "version": 1,
      "description": "Mango standard backend and frontend business module",
      "root": "code-templates/business-module",
      "roles": ["dev"],
      "phases": ["develop"],
      "keywords": ["新增模块", "创建模块", "业务模块", "module add", "business module"],
      "paths": ["backend/modules/**", "frontend/packages/**"],
      "inputs": {
        "moduleKebab": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "aggregateKebab": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "basePackage": { "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
        "groupId": { "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
        "projectKebab": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "projectVersion": { "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
        "mangoAppRuntimeVersion": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "moduleName": { "pattern": "^.{1,80}$" },
        "aggregateName": { "pattern": "^.{1,80}$" }
      },
      "derived": {
        "modulePackage": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "modulePascal": { "pattern": "^[A-Z][a-zA-Z0-9]*$" },
        "moduleCamel": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "moduleBusinessDomainCode": { "pattern": "^[A-Z][A-Z0-9_]*$" },
        "moduleKebabSnake": { "pattern": "^[a-z][a-z0-9_]*$" },
        "aggregatePascal": { "pattern": "^[A-Z][a-zA-Z0-9]*$" },
        "aggregateCamel": { "pattern": "^[a-z][a-zA-Z0-9]*$" },
        "aggregateKebabSnake": { "pattern": "^[a-z][a-z0-9_]*$" },
        "basePackagePath": { "pattern": "^[a-zA-Z0-9_/]+$" },
        "businessResourceMenuId": { "pattern": "^[0-9]{13,20}$" }
      },
      "outputs": [
        "backend/modules/{{moduleKebab}}",
        "frontend/packages/{{moduleKebab}}-api",
        "frontend/packages/{{moduleKebab}}"
      ],
      "ruleCoverage": [
        {
          "ruleIds": ["backend.module", "backend.naming"],
          "evidence": ["backend/modules/{{moduleKebab}}/pom.xml", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-api", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-starter", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-starter-remote"],
          "checks": ["maven-compile", "mango-check"]
        },
        {
          "ruleIds": ["backend.api", "backend.code"],
          "evidence": ["backend/modules/{{moduleKebab}}/{{moduleKebab}}-api/src/main/java", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/java", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-starter/src/main/java"],
          "checks": ["checkstyle", "pmd", "spotbugs", "mango-check"]
        },
        {
          "ruleIds": ["backend.db", "backend.persistence", "backend.moduleMenu"],
          "evidence": ["backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/resources/db/migration", "backend/modules/{{moduleKebab}}/{{moduleKebab}}-starter/src/main/resources/META-INF/mango"],
          "checks": ["maven-test", "mango-check"]
        },
        {
          "ruleIds": ["frontend.vue", "frontend.businessApi", "frontend.componentDevelopment"],
          "evidence": ["frontend/packages/{{moduleKebab}}-api", "frontend/packages/{{moduleKebab}}"],
          "checks": ["frontend-lint", "frontend-typecheck", "frontend-test"]
        }
      ],
      "qualityProfiles": [
        {
          "id": "mango-java-checkstyle",
          "source": "mango/mango-tools/mango-maven-plugin/src/main/resources/rulesets/java/checkstyle.xml",
          "projection": "mango-ui/packages/mango-cli/templates/full/backend/config/quality/checkstyle.xml",
          "consumerPath": "backend/config/quality/checkstyle.xml",
          "enforcedBy": "mango:check",
          "scope": "generated backend Java",
          "rules": [
            "FileLength", "FileTabCharacter", "ConstantName", "LocalFinalVariableName", "LocalVariableName",
            "MemberName", "MethodName", "PackageName", "ParameterName", "StaticVariableName", "TypeName",
            "AvoidEscapedUnicodeCharacters", "EmptyBlock", "GenericWhitespace", "Indentation", "LeftCurly",
            "MethodParamPad", "NoLineWrap", "OneStatementPerLine", "OperatorWrap", "ParenPad", "RightCurly",
            "SeparatorWrap", "WhitespaceAfter", "WhitespaceAround", "OuterTypeFilename", "DeclarationOrder",
            "OneTopLevelClass", "AvoidNestedBlocks", "EmptyStatement", "MissingSwitchDefault", "NeedBraces",
            "DefaultComesLast", "SimplifyBooleanExpression", "SimplifyBooleanReturn", "EqualsHashCode",
            "NoClone", "NoFinalizer", "CyclomaticComplexity", "MagicNumber", "CovariantEquals"
          ]
        },
        {
          "id": "mango-java-architecture",
          "source": "mango/mango-tools/mango-architecture-rules/src/main/java/io/mango/architecture/pmd/MangoJavaArchitectureRule.java",
          "sources": [
            "mango/mango-tools/mango-architecture-rules/src/main/java/io/mango/architecture/pmd/MangoJavaArchitectureRule.java",
            "mango/mango-tools/mango-architecture-rules/src/main/java/io/mango/architecture/MangoArchUnitChecker.java"
          ],
          "enforcedBy": "mango:check",
          "scope": "generated backend Java/Spring architecture",
          "rules": [
            "MANGO-ARCH-API-001", "MANGO-ARCH-API-002", "MANGO-ARCH-API-003", "MANGO-ARCH-API-004", "MANGO-ARCH-API-005",
            "MANGO-ARCH-API-006", "MANGO-ARCH-API-007", "MANGO-ARCH-BEAN-001", "MANGO-ARCH-BEAN-002",
            "MANGO-ARCH-BEAN-003", "MANGO-ARCH-BEAN-004", "MANGO-ARCH-BEAN-005", "MANGO-ARCH-BEAN-006",
            "MANGO-ARCH-CTRL-001", "MANGO-ARCH-CTRL-002", "MANGO-ARCH-CTRL-003",
            "MANGO-ARCH-CTRL-004", "MANGO-ARCH-CTRL-005", "MANGO-ARCH-CTRL-006", "MANGO-ARCH-CTRL-007",
            "MANGO-ARCH-CTRL-008", "MANGO-ARCH-CTRL-009", "MANGO-ARCH-CTRL-010", "MANGO-ARCH-CTRL-011", "MANGO-ARCH-CTRL-012", "MANGO-ARCH-CTRL-013",
            "MANGO-ARCH-ENGINE-002", "MANGO-ARCH-ENGINE-003", "MANGO-ARCH-ENGINE-004",
            "MANGO-ARCH-HTTP-001", "MANGO-ARCH-HTTP-002", "MANGO-ARCH-HTTP-003", "MANGO-ARCH-HTTP-004", "MANGO-ARCH-HTTP-005", "MANGO-ARCH-HTTP-006",
            "MANGO-ARCH-HTTP-007", "MANGO-ARCH-MAPPER-001", "MANGO-ARCH-MAPPER-002", "MANGO-ARCH-MAPPER-003", "MANGO-ARCH-MAPPER-004", "MANGO-ARCH-MAPPER-005", "MANGO-ARCH-MAPPER-006", "MANGO-ARCH-MAPPER-007",
            "MANGO-ARCH-MODEL-001", "MANGO-ARCH-MODEL-002", "MANGO-ARCH-MODEL-003", "MANGO-ARCH-MODEL-004",
            "MANGO-ARCH-MODEL-005", "MANGO-ARCH-MODEL-006", "MANGO-ARCH-MODEL-007", "MANGO-ARCH-OPENAPI-001", "MANGO-ARCH-OPENAPI-002",
            "MANGO-ARCH-OPENAPI-003", "MANGO-ARCH-OPENAPI-004", "MANGO-ARCH-OPENAPI-005", "MANGO-ARCH-OPENAPI-006",
            "MANGO-ARCH-OPENAPI-007", "MANGO-ARCH-SVC-001", "MANGO-ARCH-SVC-002", "MANGO-ARCH-SVC-003",
            "MANGO-ARCH-SVC-004", "MANGO-ARCH-SVC-005", "MANGO-ARCH-SVC-006", "MANGO-ARCH-SVC-007",
            "MANGO-ARCH-SVC-008", "MANGO-ARCH-SVC-009", "MANGO-ARCH-SVC-010", "MANGO-ARCH-SVC-011",
            "MANGO-ARCH-SVC-012", "MANGO-ARCH-SVC-013", "MANGO-ARCH-SVC-014", "MANGO-ARCH-SVC-015", "MANGO-ARCH-SVC-016",
            "MANGO-ARCH-TYPE-001", "MANGO-ARCH-TYPE-002", "MANGO-ARCH-TYPE-003",
            "MANGO-ARCH-TYPE-004", "MANGO-ARCH-TYPE-005", "MANGO-ARCH-TYPE-006", "MANGO-ARCH-TYPE-007",
            "MANGO-ARCH-TYPE-008", "MANGO-ARCH-TYPE-009", "MANGO-ARCH-TYPE-010", "MANGO-ARCH-TYPE-011",
            "MANGO-ARCH-ENTITY-001", "MANGO-ARCH-ENTITY-002", "MANGO-ARCH-ENTITY-003", "MANGO-ARCH-ENTITY-004",
            "MANGO-ARCH-FEIGN-001", "MANGO-ARCH-FEIGN-002", "MANGO-ARCH-FEIGN-003", "MANGO-ARCH-FEIGN-004",
            "MANGO-ARCH-FEIGN-005", "MANGO-ARCH-FEIGN-006", "MANGO-ARCH-FEIGN-007", "MANGO-ARCH-FEIGN-008", "MANGO-ARCH-FEIGN-009", "MANGO-ARCH-ADAPTER-001",
            "MANGO-ARCH-ADAPTER-002", "MANGO-ARCH-ADAPTER-003", "MANGO-ARCH-ADAPTER-004", "MANGO-ARCH-ADAPTER-005",
            "MANGO-ARCH-ADAPTER-006", "MANGO-ARCH-ADAPTER-007", "MANGO-ARCH-PATH-001", "MANGO-ARCH-PATH-002",
            "MANGO-ARCH-PATH-003"
          ]
        }
      ],
      "conventions": [
        { "id": "MANGO-CODE-MODULE-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-api/pom.xml", "contains": "<artifactId>{{moduleKebab}}-api</artifactId>" },
        { "id": "MANGO-CODE-ERROR-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-api/src/main/java/{{basePackagePath}}/{{modulePackage}}/api/enums/{{aggregatePascal}}Code.java", "contains": "implements BizCode" },
        { "id": "MANGO-CODE-REQUIRE-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/java/{{basePackagePath}}/{{modulePackage}}/core/service/impl/{{aggregatePascal}}Service.java", "contains": "Require.notNull" },
        { "id": "MANGO-CODE-CRUD-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/java/{{basePackagePath}}/{{modulePackage}}/core/service/impl/{{aggregatePascal}}Service.java", "contains": "extends MangoCrudServiceImpl" },
        { "id": "MANGO-CODE-ENTITY-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/java/{{basePackagePath}}/{{modulePackage}}/core/entity/{{aggregatePascal}}Entity.java", "contains": "extends TenantEntity" },
        { "id": "MANGO-CODE-MAPPER-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/java/{{basePackagePath}}/{{modulePackage}}/core/mapper/{{aggregatePascal}}Mapper.java", "contains": "extends BaseMapper<{{aggregatePascal}}Entity>" },
        { "id": "MANGO-CODE-API-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-starter/src/main/java/{{basePackagePath}}/{{modulePackage}}/starter/controller/{{modulePascal}}Controller.java", "contains": "implements {{modulePascal}}Api" },
        { "id": "MANGO-CODE-RESOURCE-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-starter/src/main/resources/META-INF/mango/resources/{{moduleKebab}}-common-menu.json", "contains": "AUTH_MENU" },
        { "id": "MANGO-CODE-MIGRATION-001", "evidence": "backend/modules/{{moduleKebab}}/{{moduleKebab}}-core/src/main/resources/db/migration/{{moduleKebab}}/V1__init_{{moduleKebab}}.sql", "contains": "CREATE TABLE" },
        { "id": "MANGO-CODE-FRONTEND-001", "evidence": "frontend/packages/{{moduleKebab}}/src/index.ts", "contains": "register{{modulePascal}}Pages" },
        { "id": "MANGO-CODE-TEST-001", "evidence": "frontend/packages/{{moduleKebab}}/src/__tests__/api-context.spec.ts", "contains": "describe(" }
      ],
      "validation": [
        "no-unresolved-placeholders",
        "no-path-traversal",
        "projection-hash",
        "generated-project-checks"
      ]
    }
  ]
}
