  "columnRules": [
    {
      "ruleId": "TDD-BOUNDARY-001",
      "section": "API 与远程契约设计",
      "headers": [
        "接口ID",
        "系统需求ID",
        "调用方",
        "所属模块",
        "入口类型",
        "方法与路径",
        "Command Query或VO",
        "返回契约",
        "校验",
        "权限租户或数据权限",
        "幂等分页或排序",
        "错误码",
        "兼容策略",
        "适用规范ruleId",
        "验证方式"
      ],
      "columns": {
        "方法与路径": {
          "forbiddenPatterns": ["\\{[^}]+\\}"],
          "requiredPatterns": [
            "^(?:GET|POST|PUT|PATCH|DELETE)\\s+/[A-Za-z0-9_./-]+$"
          ]
        },
        "Command Query或VO": {
          "forbiddenPatterns": ["\\b[A-Za-z0-9_]*(?:Entity|PO)\\b"]
        },
        "返回契约": {
          "forbiddenPatterns": [
            "\\b[A-Za-z0-9_]*(?:Entity|PO)\\b",
            "Map\\s*<\\s*String\\s*,\\s*Object\\s*>"
          ],
          "requiredPatterns": ["^R<[^<>]+>$"]
        }
      }
    }
  ],
  "forbidden": {
    "ruleId": "TDD-BOUNDARY-001",
    "codeBlocks": false,
