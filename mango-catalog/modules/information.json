{
  "schemaVersion": 1,
  "moduleId": "information",
  "frontendPackages": ["@mango/information"],
  "adminIntegration": {
    "aggregateOwner": "@mango/admin",
    "registrarExports": [
      {
        "package": "@mango/information",
        "subpath": "./admin-pages",
        "symbol": "registerMangoInformationAdminPages"
      }
    ],
    "styleEntries": [{ "package": "@mango/information", "subpath": "./style.css" }]
  },
  "backendStarters": [":mango-information-starter"],
  "presetMembership": "default"
}
