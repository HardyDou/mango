{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mango.local/catalog/release-artifact.schema.json",
  "title": "Mango synthetic release artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groupId",
    "artifactId",
    "sourceRoots",
    "requiredFiles",
    "packaging",
    "extension",
    "classifier",
    "versionSource"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "groupId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "packaging": {
      "const": "jar"
    },
    "extension": {
      "const": "jar"
    },
    "classifier": {
      "type": "null"
    },
    "versionSource": {
      "const": "maven-platform"
    }
  }
}
