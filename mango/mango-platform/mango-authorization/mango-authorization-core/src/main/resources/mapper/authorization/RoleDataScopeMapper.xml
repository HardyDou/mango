<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.mango.authorization.core.mapper.RoleDataScopeMapper">

    <select id="selectRegistryTargetById"
            resultType="io.mango.authorization.core.entity.RoleDataScopeEntity">
        select id, tenant_id, app_code, role_id, resource_code, status
        from authorization_role_data_scope
        where id = #{id}
    </select>
</mapper>
