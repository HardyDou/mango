<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.mango.org.core.mapper.PostMapper">
    <select id="selectIdByTenantAndCode" resultType="java.lang.Long">
        SELECT id
        FROM org_post
        WHERE tenant_id = #{tenantId}
          AND post_code = #{postCode}
        LIMIT 1
    </select>
</mapper>
