<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring 注入的协作者由容器管理，并非组件自身拥有的可变业务状态。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="io.mango.resource.core.service.impl.ResourceAdminService"/>
            <Class name="io.mango.resource.core.service.impl.ResourceRegistryService"/>
            <Class name="io.mango.resource.core.sync.ResourceContentHasher"/>
            <Class name="io.mango.resource.core.target.service.impl.ResourceTargetService"/>
            <Class name="io.mango.resource.starter.controller.ResourceAdminController"/>
            <Class name="io.mango.resource.starter.controller.ResourceRegistryController"/>
            <Class name="io.mango.resource.starter.remote.RemoteResourceTargetDispatcher"/>
            <Class name="io.mango.resource.starter.remote.ResourceTargetHttpClient"/>
            <Class name="io.mango.resource.support.declaration.FileResourceProvider"/>
            <Class name="io.mango.resource.support.declaration.ResourceDeclarationLoader"/>
            <Class name="io.mango.resource.sync.starter.ResourceSyncRunner"/>
            <Class name="io.mango.resource.target.starter.controller.ResourceTargetController"/>
        </Or>
    </Match>
    <!-- ConfigurationProperties 的嵌套配置对象由 Spring Binder 原位绑定。 -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="io.mango.resource.support.config.ResourceRegistryProperties"/>
        <Field name="remote"/>
    </Match>
</FindBugsFilter>
