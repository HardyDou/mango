<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        Spring-managed collaborators are shared container references, not mutable state owned by
        the receiving component. Keep these exceptions centralized and class-specific so genuine
        EI_EXPOSE_REP2 findings on domain state remain visible.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Or>
            <Class name="io.mango.authorization.starter.AuthorizationDataScopeProvider"/>
            <Class name="io.mango.identity.core.adapter.AuthorizationRoleBindingAdapter"/>
            <Class name="io.mango.identity.core.service.impl.IdentitySecurityPolicyService"/>
            <Class name="io.mango.identity.core.service.impl.IdentityTenantProvisioner"/>
            <Class name="io.mango.identity.core.service.impl.IdentityUserService"/>
            <Class name="io.mango.identity.core.service.impl.TenantMemberService"/>
            <Class name="io.mango.identity.starter.controller.IdentityUserController"/>
            <Class name="io.mango.identity.starter.controller.TenantMemberController"/>
            <Class name="io.mango.link.core.integration.LinkConfigGateway"/>
            <Class name="io.mango.notice.core.integration.NoticeIdentityGateway"/>
            <Class name="io.mango.notice.core.service.NoticeRecipientResolver"/>
            <Class name="io.mango.org.core.service.impl.SysOrgServiceImpl"/>
            <Class name="io.mango.system.core.service.impl.SysTenantServiceImpl"/>
        </Or>
    </Match>
</FindBugsFilter>
