<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mango.tools</groupId>
        <artifactId>mango-tools</artifactId>
        <version>${revision}</version>
    </parent>

    <groupId>io.mango.tools.maven.plugin</groupId>

    <artifactId>mango-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>Mango Maven Plugin</name>
    <description>AI-Friendly Java Scaffold Maven Plugin - gen-module, gen-crud, check, evaluate</description>

    <properties>
        <maven.version>3.9.15</maven.version>
        <picocli.version>4.7.5</picocli.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.mango.tools</groupId>
            <artifactId>mango-architecture-rules</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Picocli for CLI -->
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>${picocli.version}</version>
        </dependency>

        <!-- Maven Plugin API -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Maven Plugin Annotations (separate in newer Maven) -->
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>3.15.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Maven Core -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson for JSON serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Build-time Flyway baseline generation. These dependencies stay in the Maven plugin
             process and never become business runtime dependencies. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Mango Common -->
        <dependency>
            <groupId>io.mango.common</groupId>
            <artifactId>mango-common</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-testing</groupId>
            <artifactId>maven-plugin-testing-harness</artifactId>
            <version>3.5.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.codehaus.plexus</groupId>
            <artifactId>plexus-utils</artifactId>
            <version>3.6.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>3.15.2</version>
                <configuration>
                    <goalPrefix>mango</goalPrefix>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>baseline-packaging-integration-test</id>
            <activation>
                <property>
                    <name>env.MANGO_BASELINE_TEST_DB_URL</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <version>3.9.1</version>
                        <configuration>
                            <projectsDirectory>src/it</projectsDirectory>
                            <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                            <streamLogs>true</streamLogs>
                            <showErrors>true</showErrors>
                            <postBuildHookScript>verify.groovy</postBuildHookScript>
                            <goals>
                                <goal>clean</goal>
                                <goal>verify</goal>
                            </goals>
                            <properties>
                                <mango.plugin.version>${project.version}</mango.plugin.version>
                                <spring.boot.version>${spring-boot.version}</spring.boot.version>
                            </properties>
                        </configuration>
                        <executions>
                            <execution>
                                <id>baseline-packaging-integration-test</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>verify-baseline-packaging-post-build-hook</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <available
                                                file="${project.build.directory}/it/baseline-boot-package/target/invoker-post-build-hook.success"
                                                property="baselinePackagingHookExecuted"/>
                                        <fail unless="baselinePackagingHookExecuted"
                                              message="Baseline packaging Invoker post-build hook did not execute"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>baseline-packaging-negative-integration-test</id>
            <activation>
                <property>
                    <name>mango.baseline.packaging.negative</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <version>3.9.1</version>
                        <configuration>
                            <projectsDirectory>src/it-negative</projectsDirectory>
                            <cloneProjectsTo>${project.build.directory}/it-negative</cloneProjectsTo>
                            <streamLogs>true</streamLogs>
                            <showErrors>true</showErrors>
                            <postBuildHookScript>verify.groovy</postBuildHookScript>
                            <goals>
                                <goal>clean</goal>
                                <goal>package</goal>
                            </goals>
                            <properties>
                                <mango.plugin.version>${project.version}</mango.plugin.version>
                                <spring.boot.version>${spring-boot.version}</spring.boot.version>
                            </properties>
                        </configuration>
                        <executions>
                            <execution>
                                <id>baseline-packaging-missing-entry-negative-test</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
