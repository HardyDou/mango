<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.mango</groupId>
        <artifactId>mango-parent</artifactId>
        <version>${revision}</version>
        <relativePath>mango-parent/pom.xml</relativePath>
    </parent>

    <groupId>io.mango</groupId>
    <artifactId>mango</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Mango</name>
    <description>Mango Scaffold - AI-Native Java Development Framework</description>

    <properties>
        <revision>1.0.0-SNAPSHOT</revision>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mango.check.baseRef>main</mango.check.baseRef>
        <spring-boot.version>3.5.14</spring-boot.version>
        <flyway.version>11.20.3</flyway.version>
        <spring-cloud.version>2025.0.1</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.3</spring-cloud-alibaba.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <assertj.version>3.27.7</assertj.version>
        <spotbugs-plugin.version>4.9.3.0</spotbugs-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <netty.version>4.1.132.Final</netty.version>
        <tomcat.version>10.1.54</tomcat.version>
        <jackson-bom.version>2.21.2</jackson-bom.version>
        <jjwt.version>0.13.0</jjwt.version>
        <bouncycastle.version>1.84</bouncycastle.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <xz.version>1.10</xz.version>
        <commons-io.version>2.16.1</commons-io.version>
        <commons-fileupload.version>1.6.0</commons-fileupload.version>
        <plexus-utils.version>4.0.3</plexus-utils.version>
        <jodconverter.version>4.4.11</jodconverter.version>
        <aspose-words.version>20.3</aspose-words.version>
        <aspose-cells.version>20.3</aspose-cells.version>
        <aspose-slides.version>20.3</aspose-slides.version>
        <aspose-pdf.version>20.3</aspose-pdf.version>
        <aspose-imaging.version>20.3</aspose-imaging.version>
        <pdfbox.version>3.0.6</pdfbox.version>
        <ofdrw.version>2.4.0</ofdrw.version>
        <commons-imaging.version>1.0.0-alpha6</commons-imaging.version>
        <springdoc-openapi.version>2.8.9</springdoc-openapi.version>
        <knife4j.version>4.5.0</knife4j.version>
        <swagger-annotations.version>2.2.30</swagger-annotations.version>
        <ip2region.version>2.7.0</ip2region.version>
        <flowable.version>7.0.0</flowable.version>
        <poi.version>5.2.5</poi.version>
        <poi-tl.version>1.12.0</poi-tl.version>
        <hutool.version>5.8.38</hutool.version>
        <redisson.version>3.27.0</redisson.version>
        <sensitive-word.version>0.21.0</sensitive-word.version>
    </properties>

    <modules>
        <module>mango-admin-starter</module>
        <module>mango-app</module>
        <module>mango-common</module>
        <module>mango-infra</module>
        <module>mango-platform</module>
        <module>mango-extension</module>
        <module>mango-bom</module>
        <module>mango-tools</module>
    </modules>

    <distributionManagement>
        <repository>
            <id>maven-releases</id>
            <url>http://nexus.inner.yunxinbaokeji.com/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>maven-snapshots</id>
            <url>http://nexus.inner.yunxinbaokeji.com/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <!-- ==================== 依赖管理 ==================== -->

    <repositories>
        <repository>
            <id>aspose-maven-repository</id>
            <url>https://repository.aspose.com/repo</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- ==================== 插件管理 ==================== -->
    <build>
        <pluginManagement>
                <!-- 与 mango-parent 完全相同的插件（surefire / flatten / spring-boot）已删除，统一由 parent 提供。
                     compiler / pmd / checkstyle / spotbugs 是刻意覆盖（与 parent 取值不同），不要合并；改动前先读 issue #1353。 -->
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.5.0</version>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/mango-tools/mango-maven-plugin/src/main/resources/rulesets/java/checkstyle.xml</configLocation>
                        <inputEncoding>${project.build.sourceEncoding}</inputEncoding>
                        <consoleOutput>true</consoleOutput>
                        <failsOnError>false</failsOnError>
                        <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.28.0</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/mango-tools/mango-maven-plugin/src/main/resources/rulesets/java/pmd-mango.xml</ruleset>
                        </rulesets>
                        <targetJdk>${maven.compiler.release}</targetJdk>
                        <sourceEncoding>${project.build.sourceEncoding}</sourceEncoding>
                        <failOnViolation>false</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <failOnError>false</failOnError>
                        <xmlOutput>true</xmlOutput>
                        <spotbugsXmlOutputDirectory>${project.build.directory}</spotbugsXmlOutputDirectory>
                        <spotbugsXmlOutputFilename>spotbugsXml.xml</spotbugsXmlOutputFilename>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/mango-tools/mango-maven-plugin/src/main/resources/rulesets/java/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>
                <!-- Mango Maven Plugin -->
                <plugin>
                    <groupId>io.mango.tools.maven.plugin</groupId>
                    <artifactId>mango-maven-plugin</artifactId>
                    <version>${project.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>${maven.multiModuleProjectDirectory}/mango-tools/mango-maven-plugin/src/main/resources/rulesets/java/pmd-mango.xml</ruleset>
                    </rulesets>
                    <targetJdk>${maven.compiler.release}</targetJdk>
                    <sourceEncoding>${project.build.sourceEncoding}</sourceEncoding>
                    <failOnViolation>false</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
            </plugin>
            <!-- Mango Maven Plugin (for CLI: mvn mango:check) -->
            <plugin>
                <groupId>io.mango.tools.maven.plugin</groupId>
                <artifactId>mango-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
