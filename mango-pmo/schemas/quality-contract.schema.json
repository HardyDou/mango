{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mango.local/schemas/quality-contract.schema.json",
  "title": "Mango Executable Quality Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "change", "capabilities"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "filesDigest", "files"],
      "properties": {
        "base": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "head": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "filesDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "acceptance", "risk", "riskReasons", "obligations", "protectedProofPath", "allowedExternalDoubles"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 8 }
          },
          "risk": { "enum": ["R0", "R1", "R2", "R3"] },
          "riskReasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 }
          },
          "obligations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["STATIC_REVIEW", "UNIT", "API", "UI"] }
          },
          "protectedProofPath": {
            "type": "array",
            "items": { "type": "string", "minLength": 2 }
          },
          "allowedExternalDoubles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target", "reason"],
              "properties": {
                "target": { "type": "string", "minLength": 3 },
                "reason": { "type": "string", "minLength": 8 }
              }
            }
          },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "target", "reason", "alternativeEvidence", "owner", "approver", "expiresAt"],
              "properties": {
                "rule": { "type": "string", "minLength": 3 },
                "target": { "type": "string", "minLength": 3 },
                "reason": { "type": "string", "minLength": 8 },
                "alternativeEvidence": { "type": "string", "minLength": 8 },
                "owner": { "type": "string", "minLength": 2 },
                "approver": { "type": "string", "minLength": 2 },
                "expiresAt": { "type": "string", "format": "date" }
              }
            }
          }
        }
      }
    }
  }
}
