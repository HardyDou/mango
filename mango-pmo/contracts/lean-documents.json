{
  "contractSchema": 1,
  "contractId": "lean-documents",
  "schemaRevision": 2,
  "ruleSource": "mango-pmo/rules/11-delivery-assurance.md",
  "a4EquivalentContentUnits": 1800,
  "forcedL5Facts": ["NEW_MODULE", "NEW_SYSTEM", "MAJOR_ARCHITECTURE_REPLACEMENT", "CORE_MIGRATION", "IRREVERSIBLE_DATA", "CROSS_SYSTEM_MAIN_CHAIN"],
  "questionTopics": ["BUSINESS_GOAL", "ROLE_NEEDS", "BUSINESS_RULES", "STATE_DATA_SEMANTICS", "SYSTEM_BOUNDARY", "PUBLIC_CONTRACT", "DATA", "SECURITY", "TENANT", "COMPATIBILITY", "ROLLBACK", "DESTRUCTIVE_ACTION", "EXTERNAL_WRITE", "LEVEL_OVERRIDE"],
  "levels": {
    "L0": {"artifactPolicy": "NONE", "documentVersion": "直接做"},
    "L1": {"artifactPolicy": "NONE", "documentVersion": "直接做"},
    "L2": {"artifactPolicy": "SINGLE", "documentVersion": "一页纸", "template": "mango-pmo/templates/delivery-l2.md", "maxA4Pages": 1},
    "L3": {"artifactPolicy": "SINGLE", "documentVersion": "标准版", "template": "mango-pmo/templates/delivery-l3.md", "maxA4Pages": 3},
    "L4": {"artifactPolicy": "SINGLE", "documentVersion": "详细版", "template": "mango-pmo/templates/delivery-l4.md", "maxA4Pages": 5},
    "L5": {
      "artifactPolicy": "INDEPENDENT_DOCUMENTS",
      "documentVersion": "四文档",
      "templates": [
        "mango-pmo/templates/l5-business-requirements.md",
        "mango-pmo/templates/l5-system-requirements.md",
        "mango-pmo/templates/l5-technical-design.md",
        "mango-pmo/templates/l5-implementation-plan.md"
      ]
    }
  },
  "documents": {
    "delivery-l2": {
      "deliveryLevel": "L2",
      "pageBudget": 1,
      "headings": ["目标与范围", "用户故事", "系统满足方式", "参考规范与代码", "技术改动", "验证与风险"],
      "requiredPatterns": ["US-[0-9]{3}", "SR-[0-9]{3}", "TD-[0-9]{3}", "VAL-[0-9]{3}"]
    },
    "delivery-l3": {
      "deliveryLevel": "L3",
      "pageBudget": 3,
      "headings": ["业务与用户故事", "系统满足方式", "名称术语与适用图", "参考规范与代码", "技术设计与变更字典", "实施与验证"],
      "requiredPatterns": ["BR-[0-9]{3}", "US-[0-9]{3}", "SR-[0-9]{3}", "TD-[0-9]{3}", "TASK-[0-9]{3}", "VAL-[0-9]{3}", "```mermaid"]
    },
    "delivery-l4": {
      "deliveryLevel": "L4",
      "pageBudget": 5,
      "headings": ["业务与用户故事", "系统满足方式", "名称术语与适用图", "参考规范与代码", "技术设计", "实施与验证"],
      "requiredPatterns": ["BR-[0-9]{3}", "US-[0-9]{3}", "SR-[0-9]{3}", "TD-[0-9]{3}", "TASK-[0-9]{3}", "VAL-[0-9]{3}", "```mermaid"]
    },
    "business-requirements": {
      "deliveryLevel": "L5",
      "headings": ["背景与事实", "利益相关方诉求", "目标与范围", "业务需求与用户故事", "业务规则", "业务验收", "参考依据"],
      "requiredPatterns": ["BR-[0-9]{3}", "US-[0-9]{3}", "BAC-[0-9]{3}"]
    },
    "system-requirements": {
      "deliveryLevel": "L5",
      "headings": ["名称与术语", "系统满足方式", "系统流程与状态数据", "系统边界", "验收与技术引用", "参考依据"],
      "requiredPatterns": ["BR-[0-9]{3}|US-[0-9]{3}", "SR-[0-9]{3}", "TD-[0-9]{3}", "VAL-[0-9]{3}", "```mermaid"]
    },
    "technical-design": {
      "deliveryLevel": "L5",
      "headings": ["设计依据", "技术决定", "实现设计", "技术字典", "测试与回滚"],
      "requiredPatterns": ["SR-[0-9]{3}", "TD-[0-9]{3}", "VAL-[0-9]{3}", "枚举", "字段"]
    },
    "implementation-plan": {
      "deliveryLevel": "L5",
      "headings": ["交付物", "实施任务", "顺序与依赖", "数据与切换", "验证与回滚"],
      "requiredPatterns": ["DEL-[0-9]{3}", "TD-[0-9]{3}", "TASK-[0-9]{3}", "VAL-[0-9]{3}"]
    }
  },
  "referencePolicy": {
    "requiredDocumentTypes": ["delivery-l2", "delivery-l3", "delivery-l4", "business-requirements", "system-requirements", "technical-design", "implementation-plan"],
    "requiresSpecification": true,
    "requiresCodeExample": true,
    "requiresVersionOrCommit": true
  },
  "directTrace": ["US->BR", "SR->US_OR_BR", "TD->SR", "TASK->TD", "VAL->SR_OR_TASK"],
  "forbiddenFiller": ["相关改造", "充分测试", "后续优化", "按规范处理", "不涉及前端", "无数据库变化"]
}
