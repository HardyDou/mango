{
  "name": "@mango/api-schema",
  "version": "1.0.2",
  "private": false,
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/generate-package-types.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "mangoArchitecture": {
    "architectureLayer": "FE0",
    "role": "contract",
    "domain": "platform",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {}
  }
}
