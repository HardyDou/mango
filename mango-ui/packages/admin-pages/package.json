{
  "name": "@mango/admin-pages",
  "version": "1.0.34",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./defaults": {
      "types": "./dist/defaults.d.ts",
      "import": "./dist/defaults.js"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js"
    },
    "./notice": {
      "types": "./dist/notice.d.ts",
      "import": "./dist/notice.js"
    },
    "./dev-pages": {
      "types": "./dist/dev-pages.d.ts",
      "import": "./dist/dev-pages.js"
    },
    "./dev-component-pages": {
      "types": "./dist/dev-component-pages.d.ts",
      "import": "./dist/dev-component-pages.js"
    }
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@mango/admin-extension": "workspace:1.0.1",
    "@mango/auth": "workspace:1.0.27",
    "@mango/common": "workspace:1.0.27",
    "@mango/rbac": "workspace:1.0.25",
    "@mango/system": "workspace:1.0.33"
  },
  "peerDependencies": {
    "vue": ">=3.5.13 <4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^4.3.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "mangoArchitecture": {
    "architectureLayer": "FE3",
    "role": "composition",
    "domain": "platform-admin",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./core": {
        "source": "./src/core.ts",
        "kind": "code"
      },
      "./defaults": {
        "source": "./src/defaults.ts",
        "kind": "code"
      },
      "./features": {
        "source": "./src/features.ts",
        "kind": "code"
      },
      "./notice": {
        "source": "./src/notice.ts",
        "kind": "code"
      },
      "./dev-pages": {
        "source": "./src/dev-pages.ts",
        "kind": "code"
      },
      "./dev-component-pages": {
        "source": "./src/devComponentPages.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {}
  }
}
