{
  "name": "@mango/notice",
  "version": "1.0.31",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "mangoAdmin": {
    "businessDomainCode": "NOTICE",
    "businessDomainName": "通知中心",
    "groupName": "通知中心",
    "style": "@mango/notice/style.css",
    "registrars": [
      {
        "name": "registerMangoNoticeAdminPages",
        "import": "@mango/notice/admin-pages"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js"
    },
    "./admin-pages": {
      "types": "./dist/admin-pages.d.ts",
      "import": "./dist/admin-pages.js"
    },
    "./admin-shell": {
      "types": "./dist/admin-shell.d.ts",
      "import": "./dist/admin-shell.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./widgets/message-center": {
      "types": "./dist/widgets/message-center.d.ts",
      "import": "./dist/widgets/message-center.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@mango/admin-pages": "workspace:1.0.26",
    "@mango/common": "workspace:1.0.20",
    "@mango/grid-widgets": "workspace:1.0.17",
    "@mango/system": "workspace:1.0.25"
  },
  "peerDependencies": {
    "element-plus": ">=2.14.1 <3",
    "vue": ">=3.5.13 <4",
    "vue-router": ">=4.1.6 <5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^4.3.3"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "mangoArchitecture": {
    "architectureLayer": "FE2",
    "role": "domain",
    "domain": "notice",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./admin": {
        "source": "./src/admin.ts",
        "kind": "code"
      },
      "./admin-pages": {
        "source": "./src/admin-pages.ts",
        "kind": "code"
      },
      "./admin-shell": {
        "source": "./src/admin-shell.ts",
        "kind": "code"
      },
      "./client": {
        "source": "./src/client.ts",
        "kind": "code"
      },
      "./realtime": {
        "source": "./src/realtime.ts",
        "kind": "code"
      },
      "./api": {
        "source": "./src/api/notice.ts",
        "kind": "code"
      },
      "./types": {
        "source": "./src/types/notice.ts",
        "kind": "code"
      },
      "./widgets/message-center": {
        "source": "./src/widgets/message-center/message-center.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./src/style.css",
        "dist": "./dist/style.css",
        "generation": "build"
      }
    }
  }
}
