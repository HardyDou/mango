{
  "name": "@mango/auth",
  "version": "1.0.23",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@mango/common": "workspace:1.0.23",
    "@mango/api-schema": "workspace:1.0.3"
  },
  "peerDependencies": {
    "element-plus": ">=2.14.1 <3",
    "pinia": ">=2.0.32 <3",
    "vue": ">=3.5.13 <4",
    "vue-router": ">=4.1.6 <5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "happy-dom": "20.10.6",
    "typescript": "^5.9.3",
    "vite": "^4.3.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "mangoArchitecture": {
    "architectureLayer": "FE2",
    "role": "domain",
    "domain": "auth",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./src/index.ts",
        "dist": "./dist/style.css",
        "generation": "build"
      }
    }
  }
}
