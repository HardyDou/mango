{
  "name": "@mango/admin-shell",
  "version": "1.0.43",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "import": "./dist/stores.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    },
    "./home": {
      "types": "./dist/home.d.ts",
      "import": "./dist/home.js"
    },
    "./home-management": {
      "types": "./dist/home-management.d.ts",
      "import": "./dist/home-management.js"
    },
    "./home-templates": {
      "types": "./dist/home-templates.d.ts",
      "import": "./dist/home-templates.js"
    },
    "./home-list": {
      "types": "./dist/home-list.d.ts",
      "import": "./dist/home-list.js"
    },
    "./home-user": {
      "types": "./dist/home-user.d.ts",
      "import": "./dist/home-user.js"
    },
    "./dev-pages": {
      "types": "./dist/dev-pages.d.ts",
      "import": "./dist/dev-pages.js"
    },
    "./dev-base-pages": {
      "types": "./dist/dev-base-pages.d.ts",
      "import": "./dist/dev-base-pages.js"
    },
    "./dev-upload-page": {
      "types": "./dist/dev-upload-page.d.ts",
      "import": "./dist/dev-upload-page.js"
    },
    "./dev-workflow-page": {
      "types": "./dist/dev-workflow-page.d.ts",
      "import": "./dist/dev-workflow-page.js"
    },
    "./style.css": "./style.css"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "style.css",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@mango/admin-pages": "1.0.21",
    "@mango/app-runtime": "1.0.4",
    "@mango/auth": "1.0.16",
    "@mango/common": "1.0.17",
    "@mango/grid-layout": "1.0.8",
    "@mango/grid-widgets": "1.0.14",
    "@mango/home": "1.0.6",
    "@mango/job": "1.0.14",
    "@mango/rbac": "1.0.14",
    "element-plus": "2.14.1",
    "@mango/file": "1.0.22",
    "@mango/notice": "1.0.24",
    "@mango/workflow": "1.0.28"
  },
  "peerDependencies": {
    "@mango/file": "1.0.22",
    "@mango/grid-layout": "1.0.8",
    "@mango/grid-widgets": "1.0.14",
    "@mango/notice": "1.0.24",
    "@mango/workflow": "1.0.28",
    "pinia": ">=2.0.32 <3",
    "vue": ">=3.5.13 <4",
    "vue-i18n": ">=9.2.2 <10",
    "vue-router": ">=4.1.6 <5"
  },
  "peerDependenciesMeta": {
    "@mango/notice": {
      "optional": true
    },
    "@mango/workflow": {
      "optional": true
    },
    "@mango/file": {
      "optional": true
    },
    "@mango/grid-layout": {
      "optional": true
    },
    "@mango/grid-widgets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^4.3.3",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "mangoArchitecture": {
    "architectureLayer": "FE3",
    "role": "composition",
    "domain": "platform-admin",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./runtime": {
        "source": "./src/runtime/runtimeHost.ts",
        "kind": "code"
      },
      "./menu": {
        "source": "./src/runtime/menuHost.ts",
        "kind": "code"
      },
      "./stores": {
        "source": "./src/stores/index.ts",
        "kind": "code"
      },
      "./router": {
        "source": "./src/router.ts",
        "kind": "code"
      },
      "./home": {
        "source": "./src/views/home/index.vue",
        "kind": "code"
      },
      "./home-management": {
        "source": "./src/views/home/management/index.vue",
        "kind": "code"
      },
      "./home-templates": {
        "source": "./src/views/home/templates/index.vue",
        "kind": "code"
      },
      "./home-list": {
        "source": "./src/views/home/list/index.vue",
        "kind": "code"
      },
      "./home-user": {
        "source": "./src/views/home/user/index.vue",
        "kind": "code"
      },
      "./dev-pages": {
        "source": "./src/views/demo/registerDevPages.ts",
        "kind": "code"
      },
      "./dev-base-pages": {
        "source": "./src/views/demo/registerBaseDevPages.ts",
        "kind": "code"
      },
      "./dev-upload-page": {
        "source": "./src/views/demo/components/UploadView.vue",
        "kind": "code"
      },
      "./dev-workflow-page": {
        "source": "./src/views/demo/components/WorkflowComponentsView.vue",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./style.css",
        "dist": "./style.css",
        "generation": "static"
      }
    }
  }
}
