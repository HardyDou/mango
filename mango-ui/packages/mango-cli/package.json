{
  "name": "@mango/cli",
  "version": "1.2.6",
  "private": false,
  "type": "module",
  "bin": {
    "mango": "src/index.mjs",
    "mango-cli": "src/index.mjs"
  },
  "files": [
    "src",
    "templates",
    "admin-modules.json",
    "module-projections.json",
    "release-versions.json",
    "CHANGELOG.md",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "scripts": {
    "check:business-module-template": "node scripts/check-business-module-template.mjs",
    "check:generated-backend-gate": "node scripts/check-generated-backend-gate.mjs",
    "check:release-versions": "node scripts/check-release-versions.mjs",
    "test:packed-doctor": "node scripts/check-module-doctor-packed.mjs",
    "test": "pnpm run check:business-module-template && pnpm run check:release-versions && node scripts/check-cli.mjs && pnpm run test:packed-doctor && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@mango/pmo": "workspace:1.4.4",
    "prettier": "3.9.5"
  },
  "mangoArchitecture": {
    "architectureLayer": "TOOLING",
    "role": "tooling",
    "domain": "platform-tooling",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {},
    "nonCodeExports": {}
  }
}
