{
  "name": "{{projectKebab}}-frontend",
  "version": "{{projectVersion}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "stylelint": "stylelint \"src/**/*.{css,scss,vue}\" --allow-empty-input --max-warnings 0",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "test:unit": "vitest run",
    "build": "node scripts/build-with-report.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm typecheck && pnpm test:unit && pnpm build",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
{{frontendPackageDependencies}}
    "element-plus": "{{elementPlusVersion}}",
    "pinia": "{{piniaVersion}}",
    "vue": "{{vueVersion}}",
    "vue-i18n": "{{vueI18nVersion}}",
    "vue-router": "{{vueRouterVersion}}"
  },
  "devDependencies": {
    "@eslint/js": "{{eslintJsVersion}}",
    "@mango/cli": "1.0.105",
    "@playwright/test": "{{playwrightVersion}}",
    "@types/node": "{{nodeTypesVersion}}",
    "@vitejs/plugin-vue": "{{viteVueVersion}}",
    "eslint": "{{eslintVersion}}",
    "eslint-config-prettier": "{{eslintConfigPrettierVersion}}",
    "eslint-plugin-vue": "{{eslintPluginVueVersion}}",
    "globals": "{{globalsVersion}}",
    "postcss-html": "{{postcssHtmlVersion}}",
    "prettier": "{{prettierVersion}}",
    "stylelint": "{{stylelintVersion}}",
    "stylelint-config-recommended-vue": "{{stylelintConfigRecommendedVueVersion}}",
    "stylelint-config-standard": "{{stylelintConfigStandardVersion}}",
    "stylelint-config-standard-scss": "{{stylelintConfigStandardScssVersion}}",
    "typescript": "{{typescriptVersion}}",
    "typescript-eslint": "{{typescriptEslintVersion}}",
    "vite": "{{viteVersion}}",
    "vitest": "{{vitestVersion}}",
    "vue-tsc": "{{vueTscVersion}}"
  }
}
