{
  "name": "@mango/system",
  "version": "1.0.28",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "mangoAdmin": {
    "businessDomainCode": "SYSTEM",
    "businessDomainName": "系统管理",
    "groupName": "系统管理",
    "style": "@mango/system/style.css",
    "registrars": [
      {
        "name": "registerMangoSystemAdminPages",
        "import": "@mango/system/admin-pages"
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin-pages": {
      "types": "./dist/admin-pages.d.ts",
      "import": "./dist/admin-pages.js"
    },
    "./widgets/quick-entry": {
      "types": "./dist/widgets/quick-entry.d.ts",
      "import": "./dist/widgets/quick-entry.js"
    },
    "./widgets/user-profile": {
      "types": "./dist/widgets/user-profile.d.ts",
      "import": "./dist/widgets/user-profile.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@form-create/element-ui": "3.2.42",
    "@mango/api-schema": "workspace:1.0.3",
    "@mango/common": "workspace:1.0.22",
    "@mango/grid-widgets": "workspace:1.0.19",
    "@mango/rbac": "workspace:1.0.20",
    "form-create-designer": "3.2.11-oem"
  },
  "peerDependencies": {
    "@mango/file": "workspace:1.0.30",
    "element-plus": ">=2.14.1 <3",
    "vue": ">=3.5.13 <4",
    "vue-router": ">=4.1.6 <5"
  },
  "peerDependenciesMeta": {
    "@mango/file": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^4.3.3"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "mangoArchitecture": {
    "architectureLayer": "FE2",
    "role": "domain",
    "domain": "system",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./admin-pages": {
        "source": "./src/admin-pages.ts",
        "kind": "code"
      },
      "./widgets/quick-entry": {
        "source": "./src/widgets/quick-entry/quick-entry.ts",
        "kind": "code"
      },
      "./widgets/user-profile": {
        "source": "./src/widgets/user-profile/user-profile.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./src/style.css",
        "dist": "./dist/style.css",
        "generation": "build"
      }
    }
  }
}
