{
  "name": "@mango/admin",
  "version": "1.0.68",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js"
    },
    "./style.css": "./style.css",
    "./style-full.css": "./style-full.css"
  },
  "scripts": {
    "prepack": "pnpm run build",
    "build": "pnpm run build:style-deps && pnpm run generate:styles && vite build && node ../../scripts/generate-package-types.mjs",
    "build:style-deps": "node ./build-style-deps.mjs",
    "check:styles": "node ../../scripts/generate-package-styles.mjs --root ../.. --manifest ./packages/admin/admin-modules.json --package ./packages/admin/package.json --out ./packages/admin/generated-package-styles.css --admin-manifest-out ./packages/admin/admin-packages.json --full-style-out ./packages/admin/style-full.css --full-entry-out ./packages/admin/src/full.ts --full-types-out ./packages/admin/src/full.d.ts --build-deps-script-out ./packages/admin/build-style-deps.mjs --check",
    "generate:styles": "node ../../scripts/generate-package-styles.mjs --root ../.. --manifest ./packages/admin/admin-modules.json --package ./packages/admin/package.json --out ./packages/admin/generated-package-styles.css --admin-manifest-out ./packages/admin/admin-packages.json --full-style-out ./packages/admin/style-full.css --full-entry-out ./packages/admin/src/full.ts --full-types-out ./packages/admin/src/full.d.ts --build-deps-script-out ./packages/admin/build-style-deps.mjs"
  },
  "files": [
    "dist",
    "admin-modules.json",
    "admin-packages.json",
    "generated-package-styles.css",
    "style-full.css",
    "style.css",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@mango/admin-pages": "workspace:1.0.35",
    "@mango/admin-shell": "workspace:1.0.62",
    "@mango/app-runtime": "workspace:1.0.6",
    "@mango/auth": "workspace:1.0.28",
    "@mango/cms": "workspace:1.0.25",
    "@mango/common": "workspace:1.0.27",
    "@mango/grid-layout": "workspace:1.0.18",
    "@mango/grid-widgets": "workspace:1.0.24",
    "@mango/job": "workspace:1.0.29",
    "@mango/link": "workspace:1.0.22",
    "@mango/rbac": "workspace:1.0.26",
    "@mango/system": "workspace:1.0.34",
    "element-plus": "2.14.1"
  },
  "peerDependencies": {
    "@mango/calendar": "workspace:1.0.36",
    "@mango/file": "workspace:1.0.35",
    "@mango/notice": "workspace:1.0.41",
    "@mango/numgen": "workspace:1.0.37",
    "@mango/payment": "workspace:1.0.28",
    "@mango/template": "workspace:1.0.36",
    "@mango/workflow": "workspace:1.0.42",
    "@mango/workflow-business-example": "workspace:1.0.41",
    "pinia": ">=2.0.32 <3",
    "vue": ">=3.5.13 <4",
    "vue-i18n": ">=9.2.2 <10",
    "vue-router": ">=4.1.6 <5"
  },
  "peerDependenciesMeta": {
    "@mango/calendar": {
      "optional": true
    },
    "@mango/file": {
      "optional": true
    },
    "@mango/notice": {
      "optional": true
    },
    "@mango/numgen": {
      "optional": true
    },
    "@mango/payment": {
      "optional": true
    },
    "@mango/template": {
      "optional": true
    },
    "@mango/workflow": {
      "optional": true
    },
    "@mango/workflow-business-example": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^4.3.3"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "mangoArchitecture": {
    "architectureLayer": "FE3",
    "role": "composition",
    "domain": "platform-admin",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./full": {
        "source": "./src/full.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./style.css",
        "dist": "./style.css",
        "generation": "static"
      },
      "./style-full.css": {
        "source": "./style-full.css",
        "dist": "./style-full.css",
        "generation": "static"
      }
    }
  }
}
