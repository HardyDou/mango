{
  "name": "@mango/grid-widgets",
  "version": "1.0.17",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs && node ./scripts/copy-style.mjs"
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@mango/grid-layout": "workspace:1.0.11"
  },
  "peerDependencies": {
    "element-plus": ">=2.14.1 <3",
    "vue": ">=3.5.13 <4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^4.3.3"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "mangoArchitecture": {
    "architectureLayer": "FE2",
    "role": "domain",
    "domain": "grid",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./src/style.css",
        "dist": "./dist/style.css",
        "generation": "build"
      }
    }
  }
}
