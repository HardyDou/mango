{
  "name": "@mango/workflow-business-example",
  "version": "1.0.46",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./admin-pages": {
      "types": "./dist/admin-pages.d.ts",
      "import": "./dist/admin-pages.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run --config vitest.config.ts src/__tests__"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@mango/admin-pages": "workspace:1.0.37",
    "@mango/workflow": "workspace:1.0.47"
  },
  "peerDependencies": {
    "element-plus": ">=2.14.1 <3",
    "vue": ">=3.5.13 <4",
    "vue-router": ">=4.1.6 <5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "happy-dom": "^14.12.0",
    "typescript": "^5.9.3",
    "vite": "^4.3.3",
    "vitest": "^1.6.0"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "mangoArchitecture": {
    "architectureLayer": "FE2",
    "role": "domain",
    "domain": "workflow",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./admin-pages": {
        "source": "./src/admin-pages.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {
      "./style.css": {
        "source": "./src/index.ts",
        "dist": "./dist/style.css",
        "generation": "build"
      }
    }
  }
}
