{
  "name": "@mango/pmo",
  "version": "1.3.7",
  "private": false,
  "type": "module",
  "description": "Versioned Mango PMO baseline, document contracts, and lifecycle skills.",
  "files": [
    "dist",
    ".codex-plugin",
    "skills",
    "README.md",
    "package.json"
  ],
  "exports": {
    ".": "./dist/baseline.json",
    "./baseline.json": "./dist/baseline.json",
    "./baseline/*": "./dist/baseline/*",
    "./plugin.json": "./.codex-plugin/plugin.json",
    "./skills/*": "./skills/*"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/",
    "executableFiles": [
      "dist/baseline/tools/audit-backend-test-mocks.mjs",
      "dist/baseline/tools/delivery-contract-check.mjs",
      "dist/baseline/tools/pmo-preflight.mjs"
    ]
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "check": "node scripts/check-package.mjs"
  },
  "mangoArchitecture": {
    "architectureLayer": "TOOLING",
    "role": "tooling",
    "domain": "platform-tooling",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {},
    "nonCodeExports": {
      ".": {
        "source": "./scripts/build-package.mjs",
        "dist": "./dist/baseline.json",
        "generation": "build"
      },
      "./baseline.json": {
        "source": "./scripts/build-package.mjs",
        "dist": "./dist/baseline.json",
        "generation": "build"
      },
      "./baseline/*": {
        "source": "./scripts/build-package.mjs",
        "dist": "./dist/baseline/*",
        "generation": "build"
      },
      "./plugin.json": {
        "source": "./scripts/build-package.mjs",
        "dist": "./.codex-plugin/plugin.json",
        "generation": "build"
      },
      "./skills/*": {
        "source": "./scripts/build-package.mjs",
        "dist": "./skills/*",
        "generation": "build"
      }
    }
  }
}
