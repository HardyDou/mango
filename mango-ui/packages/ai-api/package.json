{
  "name": "@mango/ai-api",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@mango/api-schema": "workspace:1.0.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^4.3.3",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "mangoArchitecture": {
    "architectureLayer": "FE1",
    "role": "foundation",
    "domain": "ai",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {}
  }
}
