{
  "name": "@mango/admin-extension",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./features": {
      "types": "./dist/features.d.ts",
      "import": "./dist/features.js"
    },
    "./notice": {
      "types": "./dist/notice.d.ts",
      "import": "./dist/notice.js"
    }
  },
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@mango/common": "workspace:1.0.27"
  },
  "peerDependencies": {
    "vue": ">=3.5.13 <4"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^4.3.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "mangoArchitecture": {
    "architectureLayer": "FE1",
    "role": "foundation",
    "domain": "platform",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./core": {
        "source": "./src/core.ts",
        "kind": "code"
      },
      "./features": {
        "source": "./src/features.ts",
        "kind": "code"
      },
      "./notice": {
        "source": "./src/notice.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {}
  }
}
