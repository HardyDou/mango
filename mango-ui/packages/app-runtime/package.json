{
  "name": "@mango/app-runtime",
  "version": "1.0.4",
  "private": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue-micro": {
      "types": "./dist/vue-micro.d.ts",
      "import": "./dist/vue-micro.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "vue-router": "^4.1.6",
    "wujie": "^1.0.29"
  },
  "peerDependencies": {
    "vue": ">=3.5.13 <4"
  },
  "publishConfig": {
    "registry": "http://nexus.inner.yunxinbaokeji.com/repository/npm-hosted/"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "vite build && node ../../scripts/generate-package-types.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^4.3.3"
  },
  "mangoArchitecture": {
    "architectureLayer": "FE1",
    "role": "foundation",
    "domain": "platform",
    "ownerRole": "Frontend Standards Owner",
    "sourceExports": {
      ".": {
        "source": "./src/index.ts",
        "kind": "code"
      },
      "./vue-micro": {
        "source": "./src/vue-micro.ts",
        "kind": "code"
      }
    },
    "nonCodeExports": {}
  }
}
