{
  "schemaVersion": 1,
  "owner": "Frontend Standards Owner",
  "approvalMode": "single-owner",
  "baseRef": "origin/main",
  "candidateLock": "packages/mango-cli/release-versions.json",
  "scope": "standards-adoption",
  "adoptionStages": [
    {
      "name": "pilot",
      "requiredChecks": ["cms-runtime", "business-module-template"]
    },
    {
      "name": "affected",
      "requiredChecks": ["affected-workspaces", "packed-package-consumer", "sealed-business-lab"]
    },
    {
      "name": "repository",
      "requiredChecks": ["architecture-ratchet", "boundary-ratchet", "component-contracts", "static-quality-ratchet"]
    }
  ],
  "enforcement": {
    "newAndChangedCode": "blocking",
    "historicalDebt": "exact-identities-only-decrease"
  },
  "dependencyRecovery": {
