{
  "name": "mango-ui",
  "private": true,
  "description": "Mango UI - Micro Frontend Monorepo",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": ">=11.14.0 <12"
  },
  "scripts": {
    "dev": "pnpm admin:styles && pnpm -F mango-admin dev",
    "dev:micro": "pnpm admin:styles && node ./scripts/dev-micro.mjs",
    "preview:micro": "node ./scripts/preview-micro.mjs",
    "build": "pnpm -r build",
    "build:micro": "pnpm admin:styles && pnpm -F mango-admin-shell build && pnpm -F mango-admin-rbac-app build && pnpm -F mango-admin-workflow-app build && pnpm -F mango-admin-template-app build && pnpm -F mango-admin-cms-app build",
    "admin:styles": "node ./scripts/generate-package-styles.mjs --root . --manifest ./packages/admin/admin-modules.json --package ./packages/admin/package.json --out ./packages/admin/generated-package-styles.css --admin-manifest-out ./packages/admin/admin-packages.json --full-style-out ./packages/admin/style-full.css --full-entry-out ./packages/admin/src/full.ts --full-types-out ./packages/admin/src/full.d.ts --build-deps-script-out ./packages/admin/build-style-deps.mjs",
    "admin:styles:check": "node ./scripts/generate-package-styles.mjs --root . --manifest ./packages/admin/admin-modules.json --package ./packages/admin/package.json --out ./packages/admin/generated-package-styles.css --admin-manifest-out ./packages/admin/admin-packages.json --full-style-out ./packages/admin/style-full.css --full-entry-out ./packages/admin/src/full.ts --full-types-out ./packages/admin/src/full.d.ts --build-deps-script-out ./packages/admin/build-style-deps.mjs --check",
    "admin:module-styles:check": "node ./scripts/check-admin-module-style-governance.mjs",
    "package-exports:check": "node ./scripts/check-package-exports.mjs",
    "package-consumer:typecheck": "node ./scripts/check-package-consumer-typecheck.mjs",
    "test:business-lab": "node ./scripts/run-business-lab.mjs",
    "test:business-lab:container": "node ./scripts/run-business-lab-container.mjs",
    "quality:inventory": "node ./scripts/quality/frontend-inventory.mjs",
    "quality:inventory:test": "node --test ./scripts/quality/frontend-inventory.test.mjs",
    "architecture:check": "node ./scripts/quality/check-architecture.mjs",
    "frontend-boundaries:check": "node ./scripts/quality/check-frontend-boundaries.mjs",
    "check:boundaries": "pnpm architecture:check && pnpm frontend-boundaries:check",
    "component-contracts:check": "node ./scripts/quality/check-component-contracts.mjs",
    "test:micro": "node_modules/.pnpm/node_modules/.bin/playwright test --config apps/mango-admin-shell/playwright.config.ts",
    "test:e2e:p0": "pnpm test:micro --grep @p0",
    "test:e2e:p1": "pnpm test:micro --grep @p1",
    "test:e2e:p2": "pnpm test:micro --grep @p2",
    "format": "prettier --write .",
    "format:check": "node ./scripts/quality/run-static-gate.mjs prettier",
    "format:strict": "node ./scripts/quality/run-static-gate.mjs prettier --strict",
    "lint": "node ./scripts/quality/run-static-gate.mjs eslint",
    "lint:strict": "node ./scripts/quality/run-static-gate.mjs eslint --strict",
    "lint:raw": "eslint apps packages scripts --format json",
    "lint:fix": "eslint apps packages scripts --fix",
    "stylelint": "node ./scripts/quality/run-static-gate.mjs stylelint",
    "stylelint:strict": "node ./scripts/quality/run-static-gate.mjs stylelint --strict",
    "stylelint:fix": "stylelint \"{apps,packages}/**/*.{css,scss,vue}\" --fix",
    "typecheck": "node ./scripts/quality/run-static-gate.mjs typecheck",
    "typecheck:raw": "node ./scripts/quality/run-typecheck.mjs",
    "typecheck:strict": "node ./scripts/quality/run-static-gate.mjs typecheck --strict",
    "quality:gate:test": "node --test ./scripts/quality/*.test.mjs",
    "quality:versions": "node ./scripts/quality/check-toolchain-versions.mjs",
    "runtime-config:check": "node ./scripts/quality/check-runtime-config-separation.mjs",
    "standards:adoption:check": "node ./scripts/quality/check-frontend-standards-adoption.mjs",
    "check:static": "pnpm quality:versions && pnpm check:boundaries && pnpm component-contracts:check && pnpm runtime-config:check && pnpm lint && pnpm format:check && pnpm stylelint && pnpm typecheck",
    "test:unit": "pnpm quality:gate:test && pnpm -r --if-present test",
    "check:full": "pnpm quality:inventory && pnpm admin:styles:check && pnpm build && pnpm check:static && pnpm test:unit && pnpm package-exports:check && pnpm package-consumer:typecheck -- --reuse-build && pnpm standards:adoption:check",
    "check:standards-candidate": "pnpm test:business-lab:container",
    "check:affected": "node ./scripts/quality/check-affected.mjs",
    "check": "node ./scripts/quality/check-affected.mjs",
    "publish:pkg": "node ./scripts/publish-package.mjs",
    "release:impact": "node ./scripts/check-release-impact.mjs",
    "release:verify-npm": "node ./scripts/verify-npm-tarball.mjs",
    "release:check-notes": "node ./scripts/check-release-notes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/compiler-sfc": "3.5.13",
    "@vue/test-utils": "2.4.11",
    "axios": "1.18.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "happy-dom": "20.10.6",
    "postcss": "8.5.19",
    "postcss-html": "1.8.1",
    "prettier": "3.9.5",
    "sass": "1.101.0",
    "stylelint": "17.14.0",
    "stylelint-config-recommended-vue": "1.6.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue": "3.5.13",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "3.3.7"
  }
}
